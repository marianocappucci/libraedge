#!/bin/sh
# postrm de libraedge-caja-@PRODUCTO@ (ADR-017): el .desktop y la app los saca dpkg; aca se rehacen los favoritos
# del dock sin esta caja (con el script de otra caja que quede, o se borra el override si era la ultima).
set -e
case "$1" in
    remove|purge)
        otro=""
        for d in /opt/libraedge-caja/*/dock.sh; do [ -x "$d" ] && otro="$d" && break; done
        if [ -n "$otro" ]; then
            "$otro" || true
        elif [ -e /usr/share/glib-2.0/schemas/91_libraedge-caja.gschema.override ]; then
            rm -f /usr/share/glib-2.0/schemas/91_libraedge-caja.gschema.override
            glib-compile-schemas /usr/share/glib-2.0/schemas 2> /dev/null || true
        fi
        rmdir /opt/libraedge-caja 2> /dev/null || true
        ;;
esac
exit 0
