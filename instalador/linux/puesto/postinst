#!/bin/sh
# postinst de libraedge-puesto-@PRODUCTO@ (ADR-017): la app de @NOMBRE@ para los otros puestos del local, sin nodo.
# Solo fija el acceso directo en el dock; la PC principal se busca al abrir la app.
set -e
case "$1" in
    configure|triggered)
        /opt/libraedge-puesto/@PRODUCTO@/dock.sh || true
        if [ "$1" = configure ]; then
            cat <<'TEXTO'

  @NOMBRE@ para los otros puestos del local, instalado.
  Abrir @NOMBRE@ desde el menu de aplicaciones (o el dock): busca sola la
  PC principal del local (la que tiene el nodo LibraEdge) en la red. Si no
  la encuentra, pide su direccion, que la PC principal muestra en el icono
  de LibraEdge junto al reloj ("Otros puestos: http://...").

TEXTO
        fi
        ;;
esac
exit 0
