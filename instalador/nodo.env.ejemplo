# Las variables del proceso del nodo. El instalador escribe este archivo con
# ACL restringida: contiene el secreto que autoriza a escribir en el central.
#
# Los cuatro primeros valores los emite el central, con:
#     python -m scripts.nodo_offline registrar <node-id> --sucursal <sucursal>

# El id de este nodo, el mismo con el que se registró en el central.
LIBRAEDGE_NODE_ID=nodo-sucursal-centro

# 🔴 El secreto se muestra UNA SOLA VEZ al registrar: sólo se guarda su hash.
# Si se pierde, hay que volver a registrar el nodo — lo que invalida el anterior,
# que es también cómo se da de baja una PC robada.
LIBRAEDGE_NODE_SECRET=

# La base del central, sin la ruta. El nodo le agrega /sync/v1/...
LIBRAEDGE_CENTRAL_URL=https://cliente.restolibra.com.ar

# El PostgreSQL local de esta PC. Escucha sólo en 127.0.0.1, y no en el 5432
# por defecto: la máquina puede tener ya un PostgreSQL de otra cosa.
LIBRAEDGE_DATABASE_URL=postgresql://postgres:CLAVE@127.0.0.1:55432/restolibra

# 🔴 El reparto de autoridad, hecho lista: `tabla:pk` separadas por coma. Es la
# frontera que impide que el central le haga escribir al nodo en tablas de su
# PROPIA autoridad, como ventas. No tiene default a propósito — un default vacío
# la volvería opcional en la práctica.
#
# Tiene que coincidir con lo que el central publica: si el central publica una
# tabla que no está acá, el nodo la rechaza y la bajada queda trabada en ese
# cursor. El comando `registrar` imprime la lista exacta.
LIBRAEDGE_TABLAS_ESPEJO=

# Donde el nodo escribe su estado, para que lo lea una UI. Se escribe de forma
# atómica, así que se puede leer en cualquier momento.
LIBRAEDGE_ESTADO=C:\ProgramData\LibraEdge\estado.json

# El producto lee la suya, y apunta a la misma base local.
RESTOLIBRA_DATABASE_URL=postgresql://postgres:CLAVE@127.0.0.1:55432/restolibra

# UTC-3 fijo, sin horario de verano. Ojo: esto mueve el reloj del PROCESO. El
# del SERVIDOR PostgreSQL se fija en el initdb y no se puede cambiar después con
# una variable de entorno — se verifica con `select now()`, no con la hora del
# sistema operativo.
TZ=America/Argentina/Buenos_Aires
