[Desktop Entry]
Type=Application
Version=1.0
Name=@NOMBRE@
GenericName=Sistema del local
Comment=Abre @NOMBRE@ desde la copia de este local, aunque haya internet
Exec=/opt/libraedge-nodo/bandeja/abrir_producto.sh http://localhost:@PUERTO@/
Icon=/opt/libraedge-nodo/marca/@PRODUCTO@.svg
Terminal=false
Categories=Office;Finance;
