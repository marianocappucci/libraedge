#!/bin/sh
# prerm de libraedge-nodo-@PRODUCTO@ (ADR-012).
#
# - upgrade: para el producto y el nodo (las migraciones no corren con el
#   producto atendiendo); el postinst los vuelve a arrancar.
# - remove: para y deshabilita todo, incluido el cluster del nodo (queda en
#   disco y no arranca solo). Los DATOS NO se tocan: el outbox puede tener ventas
#   que todavia no subieron al central.
set -e
case "$1" in
    upgrade)
        systemctl stop libraedge-producto.service libraedge-nodo.service 2> /dev/null || true
        ;;
    remove|deconfigure)
        systemctl disable --now libraedge-producto.service libraedge-nodo.service libraedge-respaldo.timer libraedge-estado.path 2> /dev/null || true
        systemctl stop libraedge-respaldo.service libraedge-estado.service 2> /dev/null || true
        if [ -f /etc/postgresql/16/libraedge/start.conf ]; then
            systemctl disable --now postgresql@16-libraedge.service 2> /dev/null || true
            sed -i 's/^\s*auto\s*$/manual/' /etc/postgresql/16/libraedge/start.conf || true
        fi
        pkill -f /opt/libraedge-nodo/bandeja/bandeja_linux.py 2> /dev/null || true
        ;;
esac
exit 0
