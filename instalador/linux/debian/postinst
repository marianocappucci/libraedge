#!/bin/sh
# postinst de libraedge-nodo-@PRODUCTO@ (ADR-012).
#
# - Primera instalacion SIN carga: deja los archivos y explica como configurar
#   (sale con 0: el paquete queda instalado; el nodo, sin configurar).
# - Con LIBRAEDGE_CODIGO y LIBRAEDGE_DIRECCION en el entorno (el codigo de
#   vinculacion de «Sucursal sin internet», ADR-014) o con
#   LIBRAEDGE_CARGA=/ruta/carga-nodo.json: configura, y si la configuracion falla
#   sale con error (apt lo informa) y se reintenta con `sudo libraedge-nodo-instalar
#   --codigo ... --direccion ...` (con un codigo nuevo) o `<carga>`.
# - Actualizacion de un nodo ya configurado: migra y rearranca con el nodo.env
#   que ya esta (no vuelve a pedir la carga; conserva SECRET_KEY y los datos).
# - Siempre: fija el acceso directo del producto en el dock (dock.sh, ADR-013),
#   tambien cuando lo dispara el trigger sobre /usr/share/glib-2.0/schemas.
set -e
dock() {
    # El acceso directo del producto, fijado en el dock de todos los usuarios (ADR-013). Nunca hace fallar.
    /opt/libraedge-nodo/instalador/dock.sh agregar libraedge-nodo-@PRODUCTO@.desktop || true
}
case "$1" in
    triggered)
        # Cambiaron los esquemas del sistema (los favoritos por defecto de ubuntu-settings): se rehace el del dock.
        dock
        ;;
    configure)
        systemctl daemon-reload || true
        dock
        if [ -n "${LIBRAEDGE_CODIGO:-}" ]; then
            # El codigo sigue en el entorno: instalar.sh lo lee de ahi, sin pasarlo por la linea de comandos.
            /opt/libraedge-nodo/instalador/instalar.sh
        elif [ -n "${LIBRAEDGE_CARGA:-}" ]; then
            /opt/libraedge-nodo/instalador/instalar.sh "$LIBRAEDGE_CARGA"
        elif [ -s /etc/libraedge-nodo/nodo.env ]; then
            /opt/libraedge-nodo/instalador/instalar.sh
        else
            cat <<'TEXTO'

  Nodo LibraEdge de @NOMBRE@ instalado, SIN CONFIGURAR.
  Configurarlo con la direccion y el codigo que muestra el sistema
  (Configuracion > «Sucursal sin internet», al dar de alta el nodo):
  abrir @NOMBRE@ desde el menu de aplicaciones (o el dock) y escribirlos
  en «Vincular con el sistema», o en una terminal:

      sudo libraedge-nodo-instalar --codigo <codigo> --direccion <direccion>

  (o, si soporte le dio el archivo de carga: sudo libraedge-nodo-instalar /ruta/carga-nodo.json)

  Despues: sudo libraedge-nodo-verificar

TEXTO
        fi
        ;;
esac
exit 0
