[Desktop Entry]
Type=Application
Version=1.0
Name=@NOMBRE@
GenericName=Sistema del local
Comment=Abre @NOMBRE@ desde la PC principal del local (otra caja)
Exec=/opt/libraedge-caja/@PRODUCTO@/libraedge-caja-@PRODUCTO@
Icon=/opt/libraedge-caja/@PRODUCTO@/marca.svg
Terminal=false
Categories=Office;Finance;
Keywords=LibraEdge;caja;ventas;
StartupNotify=true
StartupWMClass=libraedge-caja-@PRODUCTO@
