# Las variables del nodo (el ejemplo es de VentaLibra). El instalador escribe
# este archivo con ACL restringida: contiene el secreto que autoriza a escribir
# en el central. NO se escribe a mano: lo arma `libraedge_instalador.py entorno`
# a partir de la definicion del producto (productos/<producto>.json) y de la
# carga del nodo (ADR-010).
#
# Lo que viene de la carga lo emite el central, con:
#     libraedge-central nodo registrar <node_id> --sucursal <sucursal> \
#         --carga carga-nodo.json --central-url https://...

# El id de este nodo, el mismo con el que se registró en el central.
LIBRAEDGE_NODE_ID=nodo-sucursal-centro

# 🔴 El secreto se muestra UNA SOLA VEZ al registrar: sólo se guarda su hash.
# Si se pierde, hay que volver a registrar el nodo — lo que invalida el anterior,
# que es también cómo se da de baja una PC robada.
LIBRAEDGE_NODE_SECRET=

# El prefijo de numeracion de ESTE nodo (S02, S02B...): las ventas salen
# S02-POS-000123. Lo asigna el central y no se repite. Sin prefijo el nodo no vende.
LIBRAEDGE_PREFIJO=S02

# La base del central, sin la ruta. El nodo le agrega /sync/v1/...
LIBRAEDGE_CENTRAL_URL=https://cliente.ventalibra.com.ar

# El PostgreSQL local de esta PC. Escucha sólo en 127.0.0.1, y no en el 5432
# por defecto: la máquina puede tener ya un PostgreSQL de otra cosa.
LIBRAEDGE_DATABASE_URL=postgresql://postgres:CLAVE@127.0.0.1:55432/ventalibra

# 🔴 El reparto de autoridad, hecho lista: `tabla:pk` separadas por coma. Es la
# frontera que impide que el central le haga escribir al nodo en tablas de su
# PROPIA autoridad, como ventas. No tiene default a propósito — un default vacío
# la volvería opcional en la práctica.
#
# Tiene que coincidir con lo que el central publica: si el central publica una
# tabla que no está acá, el nodo la rechaza y la bajada queda trabada en ese
# cursor. El comando `registrar` imprime la lista exacta.
LIBRAEDGE_TABLAS_ESPEJO=

# Donde el nodo escribe su estado, para que lo lea una UI. Se escribe de forma
# atómica, así que se puede leer en cualquier momento. El producto lo lee para
# saber si está en línea: sin él, el nodo está siempre «sin conexión» y no factura.
LIBRAEDGE_ESTADO=C:\Program Files\LibraEdge\estado.json

# Cómo calcula el nodo la versión de su esquema (409 si no es la del central).
LIBRAEDGE_VERSION_ESQUEMA=alembic

# Las del producto, una por cada variable de cada base de la definición. La
# CLAVE va codificada para URL.
VENTALIBRA_DATABASE_URL=postgresql://postgres:CLAVE@127.0.0.1:55432/ventalibra
VENTALIBRA_LIBRACORE_DATABASE_URL=postgresql://postgres:CLAVE@127.0.0.1:55432/ventalibra

# El DATA_DIR del producto: config.json (con los datos del emisor que trajo la
# carga), backups, errores. Fuera de Program Files: sobrevive a desinstalar.
DATA_DIR=C:\ProgramData\LibraEdge\app

# El secreto de sesion del PRODUCTO, no el del nodo. Son dos cosas distintas:
# LIBRAEDGE_NODE_SECRET lo emite el central y autoriza a escribir alla;
# SECRET_KEY es local de esta maquina y firma las cookies de sesion de la app.
#
# Sin esto la app NO LEVANTA: libraauth aborta con "SECRET_KEY no esta seteado".
# Falto en la primera version de este archivo y el sintoma fue el peor posible:
# el servicio en bucle de reinicio, Windows mostrandolo Running, y nada
# escuchando en el puerto (medido en una VM el 2026-08-30).
#
# Lo genera el instalador con el generador criptografico del sistema: no
# se pide al que instala ni se copia de otra instancia.
SECRET_KEY=

# El admin que el producto crea al arrancar con la tabla de usuarios vacía.
# Aleatoria y la misma en las dos: sin ella unos productos no arrancan y otros
# la inventan y la escriben en el log. Nadie la usa: los usuarios bajan del
# central. Se conserva al reinstalar, igual que SECRET_KEY.
ADMIN_PASSWORD=
VENTALIBRA_ADMIN_PASSWORD=

# UTC-3 fijo, sin horario de verano. Ojo: esto mueve el reloj del PROCESO. El
# del SERVIDOR PostgreSQL se fija en el initdb y no se puede cambiar después con
# una variable de entorno — se verifica con `select now()`, no con la hora del
# sistema operativo.
TZ=America/Argentina/Buenos_Aires
